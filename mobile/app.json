{
  "expo": {
    "name": "AssignedToMe",
    "slug": "assignedtome",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "scheme": "assignedtome",
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "enabled": true,
      "fallbackToCacheTimeout": 0
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "buildNumber": "1",
      "bundleIdentifier": "com.mytask.mobile",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mytask.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#2B2D31",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F6F8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#0F1112",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-image",
      "expo-localization",
      "expo-updates",
      "expo-background-task",
      "expo-notifications",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "AssignedToMe uses the camera only to scan the QR code from the desktop app.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "400b6e00-4f55-441a-9274-78aa966b68a2"
      }
    },
    "owner": "enesakkose"
  }
}
