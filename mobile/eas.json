{
  "cli": {
    "appVersionSource": "remote",
    "version": ">= 15.0.0"
  },
  "build": {
    "development": {
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal"
    },
    "development-simulator": {
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "bun": "1.3.9"
    }
  },
  "submit": {
    "production": {}
  }
}
