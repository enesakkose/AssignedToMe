<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the bundle's Info.plist by Tauri. assignedtome:// only brings the app forward (the browser sign-in
     page links to it); the app reads nothing from the URL. -->
<plist version="1.0">
<dict>
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>com.mytask.desktop</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>assignedtome</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
